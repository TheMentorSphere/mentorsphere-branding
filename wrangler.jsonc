{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thementorsphere",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./docs",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/forms/*",
      "/forms/primary-learner-profile",
      "/forms/primary-learner-profile/*"
    ]
  },
  "vars": {
    "FORM_PAGE_ENABLED": "false",
    "FORM_SUBMISSIONS_ENABLED": "false",
    "TURNSTILE_SITE_KEY": "CONFIGURE_BEFORE_PRODUCTION_LAUNCH",
    "TURNSTILE_EXPECTED_HOSTNAMES": "www.thementorsphere.co.uk",
    "TURNSTILE_TEST_MODE": "false"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY",
      "INTAKE_APPS_SCRIPT_URL",
      "INTAKE_HMAC_SECRET"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false
    }
  },
  "routes": [
    {
      "pattern": "www.thementorsphere.co.uk",
      "custom_domain": true
    }
  ],
  "env": {
    "staging": {
      "name": "thementorsphere-intake-staging",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "vars": {
        "FORM_PAGE_ENABLED": "false",
        "FORM_SUBMISSIONS_ENABLED": "false",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "TURNSTILE_EXPECTED_HOSTNAMES": "example.com",
        "TURNSTILE_TEST_MODE": "true"
      },
      "secrets": {
        "required": [
          "TURNSTILE_SECRET_KEY",
          "INTAKE_APPS_SCRIPT_URL",
          "INTAKE_HMAC_SECRET"
        ]
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": false
        }
      }
    }
  }
}
